{
  "version": 1,
  "author": "STM32 automated development example",
  "editor": "wokwi",
  "parts": [
    {"type":"board-stm32-bluepill","id":"mcu","top":0,"left":0,"attrs":{}},
    {"type":"wokwi-led","id":"led","top":-30,"left":210,"attrs":{"color":"green"}},
    {"type":"wokwi-resistor","id":"r1","top":65,"left":190,"attrs":{"value":"330"}},
    {"type":"wokwi-pushbutton","id":"button","top":160,"left":210,"attrs":{"color":"blue","label":"MODE"}}
  ],
  "connections": [
    ["mcu:A0","r1:1","green",[]],
    ["r1:2","led:A","green",[]],
    ["led:C","mcu:GND.1","black",[]],
    ["button:1.l","mcu:B12","blue",[]],
    ["button:2.l","mcu:GND.1","black",[]],
    ["mcu:A9","$serialMonitor:RX","orange",[]],
    ["mcu:A10","$serialMonitor:TX","orange",[]]
  ],
  "serialMonitor":{"display":"always","newline":"lf"}
}
